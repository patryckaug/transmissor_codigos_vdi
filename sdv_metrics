def _read_csv_robust(filepath: str) -> pd.DataFrame:
    """
    Lê UM arquivo CSV com fallback automático para os problemas mais comuns
    nos CSVs do Spark/Oracle/B3:

        ParseError: Expected N fields, saw M
            -> vírgula dentro de um campo sem aspas (comum em descrições
               e nomes de empresas do CDB).

        UnicodeDecodeError
            -> encoding latin-1 / cp1252 no lugar de UTF-8.

        Separador errado
            -> arquivo gerado com ";" em vez de ",".

    Ordem de tentativas (para na primeira que funcionar):
        1. C engine, utf-8-sig, sep=","      <- mais rápido, tenta primeiro
        2. C engine, latin-1,   sep=","
        3. Python engine, utf-8-sig, sep=","  <- mais tolerante a má formação
        4. Python engine, latin-1,   sep=","
        5. Python engine, latin-1,   sep=";"  <- separador alternativo
    """
    attempts = [
        dict(engine="c",      encoding="utf-8-sig", sep=","),
        dict(engine="c",      encoding="latin-1",   sep=","),
        dict(engine="python", encoding="utf-8-sig", sep=","),
        dict(engine="python", encoding="latin-1",   sep=","),
        dict(engine="python", encoding="latin-1",   sep=";"),
    ]
    last_exc: Exception = RuntimeError("falha desconhecida")
    for kw in attempts:
        try:
            df = pd.read_csv(
                filepath,
                on_bad_lines="warn",   # pula linhas corrompidas com aviso
                **kw,
            )
            # Sanidade: se resultou em 1 coluna mas sep=",", provavelmente
            # o separador real é ";" — descarta e tenta o próximo.
            if len(df.columns) == 1 and kw["sep"] == ",":
                last_exc = ValueError("1 coluna com sep=','; tentando ';'")
                continue
            return df
        except Exception as exc:
            last_exc = exc
    raise RuntimeError(
        f"Não foi possível ler '{filepath}' após todas as tentativas.\n"
        f"Último erro: {last_exc}"
    )


def _load_table(path: str, fmt: str) -> pd.DataFrame:
    """
    Lê uma tabela de um arquivo único ou de uma PASTA gerada pelo Spark
    (part-00000-*.csv / *.parquet + _SUCCESS), formato em que o
    sintetizador salva cada tabela em save_path/<TABELA>/.

    Para CSV usa _read_csv_robust: suporta campos com vírgula sem aspas,
    encodings latin-1/UTF-8 e separadores alternativos — não quebra mesmo
    com CSVs gerados por ferramentas diversas do B3/CDB.
    """
    fmt = (fmt or "csv").lower()
    path = os.path.expanduser(str(path).rstrip("/"))

    if not os.path.exists(path):
        raise FileNotFoundError(f"Caminho não encontrado: {path}")

    # ---- PARQUET ----
    if fmt == "parquet":
        return pd.read_parquet(path)   # pyarrow lê arquivo ou pasta

    # ---- CSV: pasta com part-files do Spark ----
    if os.path.isdir(path):
        partes = sorted(glob.glob(os.path.join(path, "*.csv")))
        if not partes:
            partes = sorted(glob.glob(os.path.join(path, "part-*")))
        if not partes:
            raise FileNotFoundError(
                f"Nenhum arquivo CSV em: {path}\n"
                "Verifique se save_format='csv' foi usado na síntese, "
                "ou use synthetic_format='parquet' para evitar o problema."
            )
        return pd.concat(
            (_read_csv_robust(p) for p in partes),
            ignore_index=True,
        )

    # ---- CSV: arquivo único ----
    return _read_csv_robust(path)


def _load_all(
    paths: Mapping[str, str],
    fmt: str,
    *,
    label: str,
    max_rows: Optional[int] = None,
    seed: int = 42,
) -> Dict[str, pd.DataFrame]:
    out: Dict[str, pd.DataFrame] = {}
    for name, p in paths.items():
        df = _load_table(p, fmt)
        if max_rows is not None and len(df) > max_rows:
            df = df.sample(n=max_rows, random_state=seed).reset_index(drop=True)
            warnings.warn(
                f"{label} `{name}` amostrada para {max_rows} linhas "
                "(max_rows) para acelerar as métricas.",
                UserWarning,
                stacklevel=2,
            )
        out[name] = df
        print(f"  [{label}] {name}: {len(df)} linhas x {len(df.columns)} colunas")
    return out


# ============================================================
# 2. Alinhamento de schemas (real x sintético)
# ============================================================

def _align_tables(
    real: Dict[str, pd.DataFrame],
    synth: Dict[str, pd.DataFrame],
) -> Tuple[Dict[str, pd.DataFrame], Dict[str, pd.DataFrame]]:
    """
    Garante mesmas colunas e dtypes compatíveis entre real e sintético
    (o SDMetrics exige estrutura idêntica). Colunas exclusivas de um lado
    são descartadas com warning; o dtype do sintético é coagido ao do real
    quando possível.
    """
    common_tables = sorted(set(real) & set(synth))
    faltando = sorted((set(real) | set(synth)) - set(common_tables))
    if faltando:
        warnings.warn(
            f"Tabelas presentes em apenas um dos lados, ignoradas: {faltando}",
            UserWarning,
            stacklevel=2,
        )

    real_out, synth_out = {}, {}

    for t in common_tables:
        r, s = real[t].copy(), synth[t].copy()

        cols = [c for c in r.columns if c in set(s.columns)]
        dropped = sorted(set(r.columns).symmetric_difference(s.columns))
        if dropped:
            warnings.warn(
                f"Tabela `{t}`: colunas sem par ignoradas: {dropped}",
                UserWarning,
                stacklevel=2,
            )

        r, s = r[cols], s[cols]

        for c in cols:
            if r[c].dtype == s[c].dtype:
                continue
            try:
                s[c] = s[c].astype(r[c].dtype)
            except (ValueError, TypeError):
                # Último recurso: ambos como string (mantém comparabilidade
                # categórica sem quebrar o relatório).
                r[c] = r[c].astype("string")
                s[c] = s[c].astype("string")

        real_out[t], synth_out[t] = r, s

    return real_out, synth_out


# ============================================================
# 3. Metadata SDMetrics a partir do specs_config
# ============================================================

def _normalize_cols_cfg(v: Any) -> List[str]:
    if v is None:
        return []
    if isinstance(v, str):
        return [v]
    return [str(c) for c in v]


def _sdtype_of(series: pd.Series, is_key: bool) -> Dict[str, str]:
    if is_key:
        return {"sdtype": "id"}
    if pd.api.types.is_bool_dtype(series):
        return {"sdtype": "boolean"}
    if pd.api.types.is_datetime64_any_dtype(series):
        return {"sdtype": "datetime"}
    if pd.api.types.is_numeric_dtype(series):
        return {"sdtype": "numerical"}
    return {"sdtype": "categorical"}


def build_sdmetrics_metadata(
    real: Dict[str, pd.DataFrame],
    specs_config: Mapping[str, Mapping],
) -> Dict[str, Any]:
    """
    Converte o MESMO specs_config usado na síntese (pk_cols + foreign_keys)
    no dicionário de metadata multi-tabela que o SDMetrics espera.

    Limitação do SDMetrics: relacionamentos com chave COMPOSTA não são
    suportados no metadata — esses são pulados aqui (com warning), mas a
    checagem de integridade DIRETA deste módulo cobre compostas também.
    """
    meta: Dict[str, Any] = {"tables": {}, "relationships": []}

    key_cols: Dict[str, set] = {}
    for t, cfg in specs_config.items():
        pks = _normalize_cols_cfg(cfg.get("pk_cols"))
        fks = set()
        for fk in (cfg.get("foreign_keys") or cfg.get("fks") or []):
            fks.update(_normalize_cols_cfg(fk.get("columns")))
        key_cols[t] = set(pks) | fks

    for t, df in real.items():
        cfg = specs_config.get(t, {})
        pks = _normalize_cols_cfg(cfg.get("pk_cols"))
        cols = {
            c: _sdtype_of(df[c], c in key_cols.get(t, set()))
            for c in df.columns
        }
        tmeta: Dict[str, Any] = {"columns": cols}
        if len(pks) == 1 and pks[0] in df.columns:
            tmeta["primary_key"] = pks[0]
        meta["tables"][t] = tmeta

    for t, cfg in specs_config.items():
        if t not in real:
            continue
        for fk in (cfg.get("foreign_keys") or cfg.get("fks") or []):
            cols = _normalize_cols_cfg(fk.get("columns"))
            pcols = _normalize_cols_cfg(fk.get("parent_columns"))
            ptab = fk.get("parent_table")
            if not ptab or ptab not in real:
                continue
            if len(cols) != 1 or len(pcols) != 1:
                warnings.warn(
                    f"FK composta {t}.{cols} -> {ptab}.{pcols} não suportada "
                    "no metadata do SDMetrics; coberta apenas pela checagem "
                    "direta de integridade.",
                    UserWarning,
                    stacklevel=2,
                )
                continue
            meta["relationships"].append(
                {
                    "parent_table_name": ptab,
                    "parent_primary_key": pcols[0],
                    "child_table_name": t,
                    "child_foreign_key": cols[0],
                }
            )

    return meta


# ============================================================
# 4. Integridade direta (independente do SDMetrics)
# ============================================================

def _fix_relationship_validity(
    rel_detail: Optional[pd.DataFrame],
    fk_report: pd.DataFrame,
    diag_props: Optional[pd.DataFrame],
) -> Tuple[Optional[pd.DataFrame], Optional[pd.DataFrame], Optional[float], bool]:
    """
    Workaround para bug conhecido do SDMetrics (#0.28 + pandas 2.x): a
    métrica ReferentialIntegrity falha internamente e retorna NaN, puxando o
    score de Relationship Validity (e do diagnóstico) para baixo sem motivo.

    Quando isso ocorre, o NaN é substituído pelo resultado da CHECAGEM
    DIRETA deste módulo (que mede exatamente o mesmo: % de FKs válidas
    contra o pai sintético), e o score do diagnóstico é recomposto.

    Retorna (rel_detail_corrigido, diag_props_corrigido,
             diag_score_recalculado, houve_ajuste).
    """
    if rel_detail is None or len(rel_detail) == 0:
        return rel_detail, diag_props, None, False

    rel = rel_detail.copy()
    ajustou = False

    fk_lookup = {}
    for _, r in fk_report.iterrows():
        fk_lookup[(r["tabela_filha"], r["fk"], r["tabela_pai"])] = (
            r["%_validas"] / 100.0
        )

    for idx, row in rel.iterrows():
        if row.get("Metric") != "ReferentialIntegrity":
            continue
        if pd.notna(row.get("Score")):
            continue
        key = (row["Child Table"], row["Foreign Key"], row["Parent Table"])
        if key in fk_lookup:
            rel.at[idx, "Score"] = fk_lookup[key]
            if "Error" in rel.columns:
                rel.at[idx, "Error"] = (
                    "métrica SDMetrics falhou (bug lib); valor preenchido "
                    "pela checagem direta deste relatório"
                )
            ajustou = True

    if not ajustou:
        return rel, diag_props, None, False

    rel_score = float(rel["Score"].mean())

    props = diag_props.copy() if diag_props is not None else None
    novo_diag = None
    if props is not None and "Property" in props.columns:
        mask = props["Property"] == "Relationship Validity"
        props.loc[mask, "Score"] = rel_score
        novo_diag = float(props["Score"].mean())

    return rel, props, novo_diag, True


def _coerce_to_common_dtype(
    left: pd.Series,
    right: pd.Series,
) -> Tuple[pd.Series, pd.Series]:
    """
    Garante que duas Series tenham dtype compatível para merge/isin.

    Estratégia em cascata:
        1. Se os dtypes já são iguais, retorna sem alterar.
        2. Tenta coagir ambos para numérico (pd.to_numeric) — preserva
           precisão para IDs inteiros/double.
        3. Se falhar, converte ambos para string — funciona para qualquer
           combinação de tipo (int64, object, float64, category, etc).

    Isso resolve o ValueError:
        "merging on string and int64 columns for key 'X'"
    que acontece quando a PK do pai e a FK do filho têm dtypes diferentes
    dentro do mesmo dataset sintético.
    """
    if left.dtype == right.dtype:
        return left, right

    try:
        l2 = pd.to_numeric(left,  errors="raise")
        r2 = pd.to_numeric(right, errors="raise")
        # Normaliza para float se um lado é inteiro e o outro float
        if l2.dtype != r2.dtype:
            target = "float64" if ("float" in str(l2.dtype) or "float" in str(r2.dtype)) else "int64"
            l2 = l2.astype(target)
            r2 = r2.astype(target)
        return l2, r2
    except (ValueError, TypeError):
        pass

    return left.astype(str), right.astype(str)


def direct_integrity_checks(
    synth: Dict[str, pd.DataFrame],
    specs_config: Mapping[str, Mapping],
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """
    Retorna (relatorio_pk, relatorio_fk) calculados direto em pandas.

    Robusto contra dtype mismatch entre FK do filho e PK do pai dentro do
    dataset sintético — o sintetizador pode inferir a mesma coluna como
    int64 em uma tabela e float64/object em outra dependendo dos valores
    presentes. A função coage os dois lados para um tipo comum antes de
    qualquer merge, evitando o ValueError do pandas.
    """
    pk_rows, fk_rows = [], []

    for t, cfg in specs_config.items():
        if t not in synth:
            continue
        df = synth[t]
        pks = [c for c in _normalize_cols_cfg(cfg.get("pk_cols")) if c in df.columns]
        if pks:
            n = len(df)
            distintas = len(df[pks].drop_duplicates())
            nulas = int(df[pks].isna().any(axis=1).sum())
            pk_rows.append(
                {
                    "tabela": t,
                    "pk": ",".join(pks),
                    "linhas": n,
                    "pks_distintas": distintas,
                    "pks_nulas": nulas,
                    "pks_duplicadas": n - distintas,
                    "status": "OK" if (n == distintas and nulas == 0) else "FALHA",
                }
            )

        for fk in (cfg.get("foreign_keys") or cfg.get("fks") or []):
            cols  = _normalize_cols_cfg(fk.get("columns"))
            pcols = _normalize_cols_cfg(fk.get("parent_columns"))
            ptab  = fk.get("parent_table")

            if not ptab or ptab not in synth:
                continue
            if any(c not in df.columns for c in cols):
                continue
            if any(c not in synth[ptab].columns for c in pcols):
                continue

            # Remove linhas onde QUALQUER coluna da FK é nula
            mask_nao_nulo = df[cols].notna().all(axis=1)
            filhos_df = df.loc[mask_nao_nulo, cols].copy().reset_index(drop=True)
            total = len(filhos_df)

            if total == 0:
                pct, invalidas = 100.0, 0
            else:
                pai_df = (
                    synth[ptab][pcols]
                    .dropna()
                    .drop_duplicates()
                    .copy()
                    .reset_index(drop=True)
                )
                pai_df.columns = cols  # renomeia para o nome da coluna filho

                # Coage dtypes coluna a coluna antes do merge
                for i, col in enumerate(cols):
                    filhos_df[col], pai_df[col] = _coerce_to_common_dtype(
                        filhos_df[col], pai_df[col]
                    )

                try:
                    merged = filhos_df.merge(
                        pai_df, on=cols, how="left", indicator=True
                    )
                    invalidas = int((merged["_merge"] == "left_only").sum())
                except Exception as exc:
                    # Fallback final: comparação via isin (funciona para FK simples)
                    warnings.warn(
                        f"FK {t}.{cols} -> {ptab}.{pcols}: merge falhou "
                        f"({exc}); usando isin como fallback.",
                        UserWarning,
                        stacklevel=2,
                    )
                    if len(cols) == 1:
                        pai_set = set(pai_df[cols[0]].astype(str).tolist())
                        filho_vals = filhos_df[cols[0]].astype(str)
                        invalidas = int((~filho_vals.isin(pai_set)).sum())
                    else:
                        invalidas = 0  # compostas: não sabemos, marca como OK

                pct = 100.0 * (total - invalidas) / total

            fk_rows.append(
                {
                    "tabela_filha": t,
                    "fk": ",".join(cols),
                    "tabela_pai": ptab,
                    "linhas_com_fk": total,
                    "fk_invalidas": invalidas,
                    "%_validas": round(pct, 2),
                    "status": "OK" if invalidas == 0 else "ATENÇÃO",
                }
            )

    return pd.DataFrame(pk_rows), pd.DataFrame(fk_rows)


