def run_comparison_report(
    *,
    original_table_paths: Mapping[str, str],
    synthetic_path: str,
    specs_config: Mapping[str, Mapping],
    original_format: str = "csv",
    synthetic_format: str = "csv",
    output_html: str = "relatorio_engordai.html",
    max_rows: Optional[int] = None,
    verbose: bool = True,
) -> Dict[str, Any]:
    """
    Compara sintético vs original em TODAS as tabelas e gera painel HTML.

    Args:
        original_table_paths: MESMO dict de caminhos usado na síntese
            (cada valor pode ser arquivo único ou pasta).
        synthetic_path: MESMO save_path usado na síntese; espera-se
            synthetic_path/<TABELA>/ por tabela.
        specs_config: MESMO specs_config da síntese (PKs e FKs).
        original_format / synthetic_format: "csv" ou "parquet"
            (synthetic_format = save_format usado na síntese).
        output_html: caminho do painel gerado.
        max_rows: se definido, amostra cada tabela para acelerar métricas
            (recomendado p/ tabelas com milhões de linhas, ex.: 50_000).

    Retorna dict com: diagnostic_score, quality_score, diagnostic_report,
    quality_report, pk_report, fk_report, html_path.
    """
    avisos: List[str] = []

    def _capturar(ws):
        for w in ws:
            avisos.append(str(w.message))

    print("=" * 64)
    print("1/5 Lendo dados ORIGINAIS...")
    with warnings.catch_warnings(record=True) as ws:
        warnings.simplefilter("always")
        real = _load_all(
            original_table_paths, original_format,
            label="original", max_rows=max_rows,
        )
        _capturar(ws)

    print("2/5 Lendo dados SINTÉTICOS...")
    synth_paths = {
        t: os.path.join(os.path.expanduser(synthetic_path.rstrip("/")), t)
        for t in original_table_paths
    }
    with warnings.catch_warnings(record=True) as ws:
        warnings.simplefilter("always")
        synth = _load_all(
            synth_paths, synthetic_format,
            label="sintético", max_rows=max_rows,
        )
        _capturar(ws)

    print("3/5 Alinhando schemas e montando metadata...")
    with warnings.catch_warnings(record=True) as ws:
        warnings.simplefilter("always")
        real, synth = _align_tables(real, synth)
        metadata = build_sdmetrics_metadata(real, specs_config)
        _capturar(ws)

    tabela_resumo = pd.DataFrame(
        [
            {
                "tabela": t,
                "linhas_original": len(real[t]),
                "linhas_sintetico": len(synth[t]),
                "fator": round(len(synth[t]) / max(len(real[t]), 1), 2),
                "colunas": len(real[t].columns),
            }
            for t in sorted(real)
        ]
    )

    print("4/5 Rodando métricas SDMetrics (diagnóstico + qualidade)...")
    diag_score = qual_score = None
    diag_props = qual_props = shapes_detail = None
    rel_detail = card_detail = None
    diag = qual = None

    try:
        diag = DiagnosticReport()
        diag.generate(real, synth, metadata, verbose=verbose)
        diag_score = float(diag.get_score())
        diag_props = diag.get_properties()
        try:
            rel_detail = diag.get_details("Relationship Validity")
        except Exception:
            rel_detail = None
    except Exception as exc:
        avisos.append(f"DiagnosticReport falhou: {exc}")

    try:
        qual = QualityReport()
        qual.generate(real, synth, metadata, verbose=verbose)
        qual_score = float(qual.get_score())
        qual_props = qual.get_properties()
        shapes_detail = qual.get_details("Column Shapes")
        try:
            card_detail = qual.get_details("Cardinality")
        except Exception:
            card_detail = None
    except Exception as exc:
        avisos.append(f"QualityReport falhou: {exc}")

    pk_report, fk_report = direct_integrity_checks(synth, specs_config)

    # Workaround do bug ReferentialIntegrity (SDMetrics x pandas 2.x):
    # NaN é preenchido pela checagem direta e o score é recomposto.
    rel_detail, diag_props_fix, diag_score_fix, rel_ajustado = (
        _fix_relationship_validity(rel_detail, fk_report, diag_props)
    )
    if rel_ajustado:
        diag_props = diag_props_fix
        if diag_score_fix is not None:
            diag_score = diag_score_fix
        avisos.append(
            "ReferentialIntegrity do SDMetrics falhou (incompatibilidade da "
            "lib com o pandas instalado); valor reposto pela checagem direta "
            "e score do diagnóstico recomposto."
        )

    print("5/5 Gerando painel HTML...")
    html_doc = _build_html_panel(
        diag_score=diag_score,
        diag_props=diag_props,
        qual_score=qual_score,
        qual_props=qual_props,
        shapes_detail=shapes_detail,
        rel_detail=rel_detail,
        card_detail=card_detail,
        rel_ajustado=rel_ajustado,
        pk_report=pk_report,
        fk_report=fk_report,
        tabela_resumo=tabela_resumo,
        avisos=avisos,
    )
    output_html = os.path.expanduser(output_html)
    with open(output_html, "w", encoding="utf-8") as f:
        f.write(html_doc)

    print("\n" + "=" * 64)
    print("RESUMO")
    print("=" * 64)
    if diag_score is not None:
        print(f"  Diagnóstico (validade+integridade): {diag_score * 100:.1f}%")
    if qual_score is not None:
        print(f"  Qualidade estatística:              {qual_score * 100:.1f}%")
    if len(pk_report):
        falhas_pk = (pk_report["status"] != "OK").sum()
        print(f"  PKs: {len(pk_report)} tabela(s), {falhas_pk} com problema")
    if len(fk_report):
        falhas_fk = (fk_report["status"] != "OK").sum()
        print(f"  FKs: {len(fk_report)} relacionamento(s), {falhas_fk} com órfãos")
    print(f"  Painel: {output_html}")

    return {
        "diagnostic_score": diag_score,
        "quality_score": qual_score,
        "diagnostic_report": diag,
        "quality_report": qual,
        "pk_report": pk_report,
        "fk_report": fk_report,
        "resumo_tabelas": tabela_resumo,
        "html_path": output_html,
        "avisos": avisos,
    }


if __name__ == "__main__":
