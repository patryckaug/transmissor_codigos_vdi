def _score_color(score: Optional[float]) -> str:
    if score is None:
        return AMBER
    if score >= 0.9:
        return TEAL
    if score >= 0.75:
        return AMBER
    return RED


def _card(titulo: str, score: Optional[float], legenda: str) -> str:
    valor = "n/d" if score is None else f"{score * 100:.1f}%"
    cor = _score_color(score)
    return f"""
    <div style="flex:1;min-width:200px;background:#fff;border:1px solid {ICE};
                border-radius:10px;padding:18px;text-align:center;">
      <div style="font-size:13px;color:{NAVY};font-weight:600;">{html.escape(titulo)}</div>
      <div style="font-size:34px;font-weight:700;color:{cor};margin:6px 0;">{valor}</div>
      <div style="font-size:11px;color:#555;">{html.escape(legenda)}</div>
    </div>"""


def _df_html(df: pd.DataFrame) -> str:
    if df is None or len(df) == 0:
        return "<p style='color:#777'>sem dados</p>"
    styled = df.copy()
    return styled.to_html(
        index=False,
        border=0,
        classes="tbl",
        float_format=lambda x: f"{x:.3f}",
        na_rep="-",
    )


def _build_html_panel(
    *,
    diag_score: Optional[float],
    diag_props: Optional[pd.DataFrame],
    qual_score: Optional[float],
    qual_props: Optional[pd.DataFrame],
    shapes_detail: Optional[pd.DataFrame],
    rel_detail: Optional[pd.DataFrame],
    card_detail: Optional[pd.DataFrame],
    rel_ajustado: bool,
    pk_report: pd.DataFrame,
    fk_report: pd.DataFrame,
    tabela_resumo: pd.DataFrame,
    avisos: List[str],
) -> str:
    piores = ""
    if shapes_detail is not None and len(shapes_detail) > 0 and "Score" in shapes_detail.columns:
        piores_df = shapes_detail.sort_values("Score").head(10)
        piores = f"""
        <h2>Colunas com menor fidelidade de distribuição (top 10)</h2>
        <p class="exp">Score 1.0 = distribuição sintética idêntica à original.
        Colunas no fim da lista merecem inspeção visual.</p>
        {_df_html(piores_df)}"""

    nota_ajuste = ""
    if rel_ajustado:
        nota_ajuste = """
        <p class="exp" style="color:#B45309;"><b>Nota:</b> a métrica
        ReferentialIntegrity do SDMetrics falhou por incompatibilidade da
        biblioteca com o pandas instalado; o valor exibido foi preenchido
        pela checagem direta deste relatório, que mede o mesmo (% de FKs
        sintéticas válidas contra o pai sintético).</p>"""

    rel_html = ""
    if rel_detail is not None and len(rel_detail) > 0:
        rel_html = f"""
        <h2>Integridade entre tabelas — detalhe por relacionamento</h2>
        <p class="exp"><b>ReferentialIntegrity</b>: % de FKs que apontam para
        uma PK existente (esperado 1.0 — é a garantia central do engine).<br>
        <b>CardinalityBoundaryAdherence</b>: % de pais sintéticos cujo nº de
        filhos cai dentro do min–max observado no original. Com bootstrap,
        valores moderados aqui são ESPERADOS: pais sintéticos novos podem
        nascer com 0 filhos sem violar nenhuma integridade.</p>
        {nota_ajuste}
        {_df_html(rel_detail)}"""

    card_html = ""
    if card_detail is not None and len(card_detail) > 0:
        card_html = f"""
        <h2>Fan-out — distribuição de filhos por pai</h2>
        <p class="exp"><b>CardinalityShapeSimilarity</b>: compara a forma da
        distribuição de filhos-por-pai entre original e sintético. Tende a
        subir com volumes maiores; em tabelas pequenas oscila por amostragem.</p>
        {_df_html(card_detail)}"""

    avisos_html = ""
    if avisos:
        itens = "".join(f"<li>{html.escape(a)}</li>" for a in avisos)
        avisos_html = f"""
        <h2>Avisos durante a avaliação</h2>
        <ul class="exp">{itens}</ul>"""

    rel_validity = ""
    if diag_props is not None and "Property" in getattr(diag_props, "columns", []):
        rel_validity = _df_html(diag_props)

    return f"""<!DOCTYPE html>
