def run_comparison_report(
    *,
    original_table_paths: "Union[str, Mapping[str, str]]",
    synthetic_path: Optional[str] = None,
    specs_config: Mapping[str, Mapping],
    original_format: str = "csv",
    synthetic_format: str = "csv",
    oci_bucket: Optional[str] = None,
    oci_namespace: Optional[str] = None,
    synthetic_prefix: Optional[str] = None,
    max_rows: Optional[int] = 50_000,
    show_distribution_plots: bool = True,
    compute_diagnostic: bool = True,
    compute_quality: bool = True,
    skip_pair_trends: bool = False,
    show_timing: bool = False,
    verbose: bool = False,
) -> Dict[str, Any]:
    """
    Compara sintético vs original e exibe o relatório INLINE no notebook.

    Parâmetros
    ----------
    original_table_paths    : dict {tabela: caminho} OU string com o prefixo
                              base (ex.: "oci://bkt@ns/onprem-export"). Sendo
                              string, monta prefixo/<TABELA> para cada tabela
                              do specs_config. Local ou oci://.
    synthetic_path          : base do sintético (synthetic_path/<TABELA>/).
                              Local OU oci://. Opcional se você informar
                              oci_bucket + oci_namespace + synthetic_prefix.
    specs_config            : mesmo specs_config da síntese (PKs e FKs)
    original_format         : "csv" ou "parquet"
    synthetic_format        : "csv" ou "parquet" (= save_format da síntese)
    oci_bucket              : nome do bucket (ex.: "qab-n"). Use com
                              oci_namespace + synthetic_prefix para montar
                              o URI sem passar synthetic_path manualmente.
    oci_namespace           : namespace da tenancy (ex.: "gr97zovfhcmu")
    synthetic_prefix        : prefixo/pasta-raiz do sintético no bucket
                              (ex.: "synthetic" ou "qab/run42/synthetic")
    max_rows                : amostra cada tabela para acelerar métricas e
                              CABER EM MEMÓRIA. Padrão 50.000 por tabela.
                              No OCI a amostragem é feita durante a leitura
                              (early-stop por part-file), evitando o OOM de
                              materializar 100k+ linhas de várias tabelas.
                              Use None para carregar tudo (cuidado com RAM).
    show_distribution_plots : exibe gráficos original vs sintético por coluna
    compute_diagnostic      : se False, pula o DiagnosticReport do SDMetrics
    compute_quality         : se False, pula o QualityReport (a parte cara)
    skip_pair_trends        : se True, calcula a qualidade só com Column Shapes
                              (KS/TV por coluna), pulando o Column Pair Trends —
                              que é O(colunas²) e costuma ser o gargalo. A
                              integridade de FK continua na checagem direta.
    show_timing             : imprime o tempo gasto em cada fase ao final
    verbose                 : passa verbose para o SDMetrics

    Resolução do caminho sintético
    ------------------------------
    Se oci_bucket E oci_namespace forem informados, o URI é montado como
    oci://{oci_bucket}@{oci_namespace}/{synthetic_prefix} e tem prioridade.
    Caso contrário, usa-se synthetic_path como veio. Um dos dois é obrigatório.

    Retorna
    -------
    dict com: diagnostic_score, quality_score, diagnostic_report,
              quality_report, pk_report, fk_report, resumo_tabelas,
              diagnostic_error, quality_error, preflight_problems
    """
    from IPython.display import display, Markdown

    # ── 0. resolver base do sintético (URI parametrizável) ───
    if oci_bucket and oci_namespace:
        synthetic_path = _build_oci_uri(
            oci_bucket, oci_namespace, synthetic_prefix or ""
        )
    if not synthetic_path:
        raise ValueError(
            "Informe synthetic_path OU (oci_bucket + oci_namespace "
            "[+ synthetic_prefix]) para localizar o sintético."
        )

    # ── 0b. normalizar original_table_paths ──────────────────
    # Aceita duas formas:
    #   • dict {tabela: caminho_completo}  -> usado como veio;
    #   • str  "prefixo/base"              -> monta prefixo/<TABELA> para cada
    #                                          tabela do specs_config.
    # As tabelas a avaliar saem SEMPRE das chaves do specs_config, garantindo
    # que original e sintético casem com o mesmo conjunto e nomes.
    tabelas = list(specs_config.keys())
    if not tabelas:
        raise ValueError("`specs_config` está vazio: não há tabelas para avaliar.")

    if isinstance(original_table_paths, str):
        original_base = original_table_paths
        original_table_paths = {
            t: _join_path(original_base, t) for t in tabelas
        }
    elif isinstance(original_table_paths, Mapping):
        original_table_paths = dict(original_table_paths)
    else:
        raise TypeError(
            "`original_table_paths` deve ser um dict {tabela: caminho} OU uma "
            "string com o prefixo base (ex.: 'oci://bkt@ns/onprem-export')."
        )

    def _sec(titulo: str, emoji: str = ""):
        display(Markdown(f"---\n### {emoji} {titulo}"))

    # ── 1. leitura ───────────────────────────────────────────
    timings: Dict[str, float] = {}
    _t0 = time.perf_counter()

    display(Markdown("# 📊 EngordAI — Avaliação Sintético vs Original"))
    print("Lendo dados originais...")
    real = _load_all(
        original_table_paths, original_format,
        label="original", max_rows=max_rows,
    )

    print("Lendo dados sintéticos...")
    synth_paths = {
        t: _join_path(synthetic_path, t)
        for t in tabelas
    }
    synth = _load_all(
        synth_paths, synthetic_format,
        label="sintético", max_rows=max_rows,
    )
    timings["leitura"] = time.perf_counter() - _t0

    _t0 = time.perf_counter()
    with _silence():
        real, synth = _align_tables(real, synth)
        metadata    = build_sdmetrics_metadata(real, specs_config)
    timings["alinhar+metadata"] = time.perf_counter() - _t0

    # ── 1b. pré-voo: detecta causas comuns de falha ANTES do cálculo ──
    preflight_problems = _preflight_metadata(real, synth, specs_config, metadata)

    # aviso sobre o efeito do sample na integridade referencial
    if max_rows:
        display(Markdown(
            f"> ⚠️ **Amostragem ativa: {max_rows:,} linhas por tabela** "
            "(para caber em memória). As métricas estatísticas (Column Shapes, "
            "Pair Trends) permanecem representativas, mas as **métricas de FK "
            "podem aparecer artificialmente baixas**: amostrar cada tabela de "
            "forma independente orfana relacionamentos que existem no dado "
            "completo. Para auditar integridade referencial de verdade, rode "
            "com `max_rows=None` ou faça subsetting referencialmente coerente."
        ))

    # ── 2. volumes ───────────────────────────────────────────
    _sec("Volumes por tabela", "📋")
    if real:
        vol = pd.DataFrame([
            {
                "tabela":            t,
                "linhas_original":   len(real[t]),
                "linhas_sintético":  len(synth[t]),
                "fator_x":           round(len(synth[t]) / max(len(real[t]), 1), 2),
                "colunas":           len(real[t].columns),
            }
            for t in sorted(real)
        ])
        display(
            vol.style
            .format({"fator_x": "{:.2f}×"})
            .set_table_styles([
                {"selector": "th",
                 "props": f"background:{_NAVY};color:white;padding:6px 8px"},
                {"selector": "td", "props": "padding:5px 8px"},
            ])
        )
    else:
        vol = pd.DataFrame()
        display(Markdown(
            "> ❌ **Nenhuma tabela em comum entre original e sintético.** "
            "Verifique nomes/casing das tabelas e os caminhos. Veja o "
            "diagnóstico de erros mais abaixo."
        ))

    # ── 3. métricas SDMetrics (gating + timing + fallback) ──
    diag_score = qual_score = None
    diag_props = qual_props = shapes_detail = None
    rel_detail = card_detail = intertable_detail = None
    diag = qual = None
    diag_error = qual_error = None
    diag_fallback = qual_fallback = False

    if not metadata.get("tables"):
        diag_error = qual_error = (
            "Metadata sem tabelas — o cálculo do SDMetrics não foi nem tentado."
        )
    else:
        # ---- Diagnóstico (barato: validade + estrutura + relacionamento) ----
        if compute_diagnostic:
            print("Calculando diagnóstico SDMetrics...")
            _t0 = time.perf_counter()
            with _silence():
                (diag, diag_score, diag_props,
                 diag_error, diag_fallback) = _try_report(
                    DiagnosticReport, real, synth, metadata, verbose
                )
                if diag is not None:
                    try:
                        rel_detail = diag.get_details("Relationship Validity")
                    except Exception:
                        pass
            timings["diagnostic"] = time.perf_counter() - _t0
        else:
            print("Diagnóstico SDMetrics PULADO (compute_diagnostic=False).")

        # ---- Qualidade (CARA: Column Pair Trends é O(colunas²) — o gargalo) ----
        if compute_quality:
            _t0 = time.perf_counter()
            if skip_pair_trends:
                print("Calculando qualidade — só Column Shapes (Pair Trends pulado)...")
                with _silence():
                    qual_score, shapes_detail = _fast_column_shapes(
                        real, synth, metadata
                    )
                if qual_score is not None:
                    qual_props = pd.DataFrame(
                        [{"Property": "Column Shapes", "Score": qual_score}]
                    )
                else:
                    qual_error = (
                        "Column Shapes rápido não retornou nenhuma coluna elegível."
                    )
            else:
                print("Calculando qualidade SDMetrics — Column Pair Trends é o passo lento...")
                with _silence():
                    (qual, qual_score, qual_props,
                     qual_error, qual_fallback) = _try_report(
                        QualityReport, real, synth, metadata, verbose
                    )
                    if qual is not None:
                        try:
                            shapes_detail = qual.get_details("Column Shapes")
                        except Exception:
                            pass
                        try:
                            card_detail = qual.get_details("Cardinality")
                        except Exception:
                            pass
                        # Intertable Trends: correlações que cruzam o vínculo
                        # pai→filho. Nem toda versão do SDMetrics calcula —
                        # por isso o try/except silencioso.
                        try:
                            intertable_detail = qual.get_details("Intertable Trends")
                        except Exception:
                            pass
            timings["quality"] = time.perf_counter() - _t0
        else:
            print("Qualidade SDMetrics PULADA (compute_quality=False).")

    # ── 4. integridade direta ────────────────────────────────
    _t0 = time.perf_counter()
    pk_report, fk_report = direct_integrity_checks(synth, specs_config)
    timings["integridade_direta"] = time.perf_counter() - _t0

    # corrige bug ReferentialIntegrity
    rel_detail, diag_props_fix, diag_score_fix, rel_ajustado = (
        _fix_relationship_validity(rel_detail, fk_report, diag_props)
    )
    if rel_ajustado:
        diag_props = diag_props_fix
        if diag_score_fix is not None:
            diag_score = diag_score_fix

    # ── 5. scorecard ─────────────────────────────────────────
    _sec("Visão Geral", "🎯")
    display(Markdown(
        "Os dois scores abaixo resumem a qualidade do dado sintético. "
        "**Verde** (≥ 90%) significa excelente. **Amarelo** (≥ 75%) é aceitável "
        "com ressalvas. **Vermelho** (< 75%) indica que algo precisa de atenção."
    ))
    _scorecard([
        ("Diagnóstico\n(validade + integridade)",
         diag_score,
         "≥ 90%: PKs únicas · FKs válidas · estrutura preservada"
            if diag_score is not None
            else "⚠ não calculado — ver diagnóstico de erros abaixo"),
        ("Qualidade estatística",
         qual_score,
         "fidelidade de distribuições · correlações · fan-out"
            if qual_score is not None
            else "⚠ não calculado — ver diagnóstico de erros abaixo"),
    ])

    # ── 5b. diagnóstico de erros (só aparece se algo falhou) ──
    houve_falha = (
        diag_score is None or qual_score is None
        or diag_fallback or qual_fallback or bool(preflight_problems)
    )
    if houve_falha:
        _sec("Diagnóstico de Erros do SDMetrics", "🛠️")
        display(Markdown(
            "> Algum cálculo do SDMetrics não rodou como esperado. Abaixo está "
            "o que foi detectado e o **erro exato** retornado pela biblioteca. "
            "A checagem direta de PK/FK mais abaixo é independente do SDMetrics "
            "e continua válida."
        ))

        if preflight_problems:
            display(Markdown("**Verificações de pré-voo que falharam:**"))
            display(Markdown("\n".join(f"- {p}" for p in preflight_problems)))

        if (diag_fallback or qual_fallback):
            display(Markdown(
                "> ℹ️ As métricas de **relacionamento** (Relationship Validity / "
                "Cardinality) foram desabilitadas para conseguir calcular o "
                "restante (Data Validity, Data Structure, Column Shapes, Pair "
                "Trends). A integridade referencial continua coberta pela "
                "checagem direta de FK mais abaixo."
            ))

        if diag_score is None and diag_error:
            display(Markdown("**DiagnosticReport — não calculado.** Último erro:"))
            display(Markdown(f"`{_last_exc_line(diag_error)}`"))
            display(Markdown("<details><summary>traceback completo</summary>\n\n"
                             + _fence(diag_error) + "\n\n</details>"))
            print("\n===== TRACEBACK DiagnosticReport =====\n" + (diag_error or ""))

        if qual_score is None and qual_error:
            display(Markdown("**QualityReport — não calculado.** Último erro:"))
            display(Markdown(f"`{_last_exc_line(qual_error)}`"))
            display(Markdown("<details><summary>traceback completo</summary>\n\n"
                             + _fence(qual_error) + "\n\n</details>"))
            print("\n===== TRACEBACK QualityReport =====\n" + (qual_error or ""))

    # ── 6. diagnóstico ───────────────────────────────────────
    _sec("Diagnóstico de Integridade", "🔍")
    display(Markdown(
        "> **O que é?** Verifica se o dado sintético é _estruturalmente correto_: "
        "se cada registro tem um identificador único, se as tabelas têm as mesmas "
        "colunas do original e se todo registro filho aponta para um registro pai que existe. "
        "Pense nisso como a _revisão técnica_: o dado não pode ser usado se não "
        "passar aqui. Score esperado: **≥ 90%**."
    ))
    display(Markdown("""
| Métrica | O que mede | Valor ideal |
|---|---|---|
| **Data Validity** | Cada coluna tem valores dentro do esperado (tipos corretos, sem lixo) | 100% |
| **Data Structure** | O dado sintético tem as mesmas colunas que o original | 100% |
| **Relationship Validity** | Todo registro filho aponta para um pai que existe (integridade FK→PK) | 100% |
"""))
    if diag_props is not None:
        display(_style_df(diag_props.round(3), score_col="Score", status_col=None))
    else:
        display(Markdown("_Diagnóstico SDMetrics indisponível (ver bloco de erros acima)._"))

    if rel_detail is not None and len(rel_detail) > 0:
        display(Markdown(
            "**Detalhe por relacionamento** — cada linha é um vínculo entre tabelas "
            "(ex.: CONTA → ENTIDADE). `ReferentialIntegrity` = % de registros filhos "
            "que têm um pai válido. `CardinalityBoundaryAdherence` = % de pais cujo "
            "número de filhos está dentro da faixa observada no original."
        ))
        if rel_ajustado:
            display(Markdown(
                "> ℹ️ `ReferentialIntegrity` retornou erro interno na biblioteca SDMetrics "
                "(incompatibilidade com a versão do pandas instalada); o valor foi "
                "substituído automaticamente pela checagem direta, que mede o mesmo."
            ))
        cols_show = [
            c for c in ["Parent Table", "Child Table", "Metric", "Score", "Error"]
            if c in rel_detail.columns
        ]
        display(_style_df(rel_detail[cols_show].round(3), score_col="Score", status_col=None))

    # ── 7. qualidade estatística ──────────────────────────────
    _sec("Qualidade Estatística", "📈")
    display(Markdown(
        "> **O que é?** Mede se o dado sintético _se comporta_ como o original: "
        "se as distribuições de cada variável são parecidas, se as correlações "
        "entre variáveis foram preservadas e se a proporção de filhos por pai "
        "continua realista. É a _revisão analítica_: um dado pode ser "
        "estruturalmente correto mas estatisticamente inútil. Score esperado: "
        "**≥ 75%** (valores acima de 80% são considerados excelentes pela comunidade SDV)."
    ))
    display(Markdown("""
| Métrica | O que mede | Valor ideal |
|---|---|---|
| **Column Shapes** | A distribuição de cada coluna individual é parecida com o original? (histograma similar) | ≥ 80% |
| **Column Pair Trends** | As correlações entre pares de colunas foram preservadas? (ex.: renda e saldo ainda sobem juntos?) | ≥ 70% |
| **Cardinality** | A proporção de filhos por pai (ex.: quantas contas por cliente) continua realista? | ≥ 70% |
"""))
    if qual_props is not None:
        display(_style_df(qual_props.round(3), score_col="Score", status_col=None))
    else:
        display(Markdown("_Qualidade SDMetrics indisponível (ver bloco de erros acima)._"))

    if skip_pair_trends and qual_score is not None:
        display(Markdown(
            "> ⚡ **Modo rápido ligado:** o score de qualidade acima reflete "
            "**apenas Column Shapes** (a distribuição de cada coluna, via KS/TV). "
            "O **Column Pair Trends** (correlações entre pares de colunas) e a "
            "**Cardinality** foram pulados — é justamente o passo O(colunas²) que "
            "torna o relatório lento em tabelas largas. Rode com "
            "`skip_pair_trends=False` para o score estatístico completo."
        ))

    if card_detail is not None and len(card_detail) > 0:
        display(Markdown(
            "**Fan-out por relacionamento** — compara a curva de quantos filhos "
            "cada pai tem entre original e sintético. Score alto = a distribuição "
            "de clientes com 1, 2, 3 contas é parecida."
        ))
        display(_style_df(card_detail.round(3), score_col="Score", status_col=None))

    if intertable_detail is not None and len(intertable_detail) > 0:
        display(Markdown(
            "**Tendências entre tabelas (Intertable Trends)** — mede se as "
            "correlações de VALORES que cruzam o vínculo pai→filho foram "
            "preservadas (ex.: o segmento da ENTIDADE ainda prediz o saldo da "
            "CONTA?). O Column Pair Trends **não** cobre isto — ele só olha "
            "pares de colunas dentro da mesma tabela. Score alto = a relação de "
            "valores entre tabelas continua realista."
        ))
        display(_style_df(intertable_detail.round(3), score_col="Score", status_col=None))

    if shapes_detail is not None and "Score" in shapes_detail.columns:
        piores = shapes_detail.sort_values("Score").head(10)
        display(Markdown(
            "**10 colunas com menor fidelidade de distribuição** — "
            "estas merecem atenção especial. Score 1.0 = distribuição idêntica ao original. "
            "Colunas com score baixo podem ter tido poucos valores distintos no original "
            "(alta cardinalidade) ou conter muitos nulos."
        ))
        display(_style_df(piores.round(3), score_col="Score", status_col=None))

    # ── 8. integridade direta PKs ────────────────────────────
    _sec("Integridade das Chaves Primárias (PK)", "🔑")
    display(Markdown(
        "> **O que é?** Verifica se cada tabela sintética tem identificadores únicos e válidos. "
        "Uma chave primária duplicada ou nula quebraria qualquer sistema que usasse o dado. "
        "Esta checagem é calculada diretamente (independente do SDMetrics). "
        "**Esperado: status OK em todas as tabelas.**"
    ))
    display(Markdown("""
| Coluna | O que significa |
|---|---|
| **linhas** | Total de registros gerados |
| **pks_distintas** | Quantas chaves únicas existem (deve ser = linhas) |
| **pks_nulas** | Registros sem identificador (deve ser 0) |
| **pks_duplicadas** | Registros com ID repetido (deve ser 0) |
"""))
    if len(pk_report):
        display(_style_df(pk_report, score_col=None, status_col="status"))
    else:
        display(Markdown("_Nenhuma PK declarada._"))

    # ── 9. integridade direta FKs ────────────────────────────
    _sec("Integridade das Chaves Estrangeiras (FK)", "🔗")
    display(Markdown(
        "> **O que é?** Verifica se os vínculos entre tabelas estão corretos. "
        "Todo registro filho (ex.: CONTA) deve apontar para um registro "
        "pai (ex.: ENTIDADE) que realmente existe no dado sintético. "
        "Registros com FK nula são excluídos do cálculo: podem ser "
        "orfaos intencionais gerados pela politica do sintetizador. "
        "Esta checagem e calculada diretamente. **Esperado: 100% validas.**"
    ))
    display(Markdown("""
| Coluna | O que significa |
|---|---|
| **linhas** | Total de registros filhos na tabela |
| **fk_nula** | Filhos com FK nula = sem pai (órfãos pela política do sintetizador) |
| **%_nula** | Percentual de filhos sem relacionamento nenhum |
| **total_fk** | Registros filhos com FK preenchida (avaliados) |
| **invalidas** | FKs preenchidas que não acharam um pai válido (deve ser 0) |
| **%_validas** | Percentual de FKs preenchidas com pai existente (deve ser 100%) |
"""))
    display(Markdown(
        "> ⚠️ **`%_validas` e `%_nula` contam coisas diferentes.** `%_validas=100%` "
        "garante que toda FK *preenchida* tem pai — mas se `%_nula` for alto, muitos "
        "filhos não têm pai algum (órfãos intencionais). Para afirmar que o "
        "relacionamento está **mantido**, olhe as duas: FKs preenchidas 100% válidas "
        "**e** `%_nula` na taxa esperada pela sua `orphan_policy`."
    ))
    if len(fk_report):
        display(_style_df(fk_report, score_col=None, status_col="status"))
    else:
        display(Markdown("_Nenhuma FK declarada._"))

    # ── 10. distribuições ────────────────────────────────────
    if show_distribution_plots and real:
        _sec("Distribuições: Original vs Sintético", "📊")
        display(Markdown(
            "> **O que é?** Compara visualmente a forma da distribuição de cada "
            "variável entre o dado original e o sintético. "
            "**Barras sobrepostas** = o sintetizador reproduziu bem aquela variável. "
            "**Barras muito diferentes** = a distribuição foi alterada (pode ser "
            "aceitável dependendo do objetivo, mas vale investigar)."
        ))
        display(Markdown(
            "🔵 **Azul escuro** = original &nbsp;·&nbsp; "
            "🩵 **Verde azulado** = sintético"
        ))
        _t0 = time.perf_counter()
        _dist_plots(real, synth)
        timings["graficos"] = time.perf_counter() - _t0

    # ── 11. resumo final ─────────────────────────────────────
    display(Markdown("---"))
    falhas_pk = int((pk_report["status"] != "OK").sum()) if len(pk_report) else 0
    falhas_fk = int((fk_report["status"] != "OK").sum()) if len(fk_report) else 0
    sdmetrics_ok = (diag_score is not None and qual_score is not None)
    icone     = ("✅" if (falhas_pk == 0 and falhas_fk == 0 and sdmetrics_ok)
                 else "⚠️")
    d_txt     = f"{diag_score * 100:.1f}%" if diag_score is not None else "n/d"
    q_txt     = f"{qual_score * 100:.1f}%" if qual_score is not None else "n/d"
    display(Markdown(
        f"**{icone} Resumo final** &nbsp;·&nbsp; "
        f"Diagnóstico: **{d_txt}** &nbsp;·&nbsp; "
        f"Qualidade: **{q_txt}** &nbsp;·&nbsp; "
        f"PKs com problema: **{falhas_pk}** &nbsp;·&nbsp; "
        f"FKs com órfãos: **{falhas_fk}**"
    ))

    # ── 12. tempo por fase (opcional) ────────────────────────
    if show_timing and timings:
        _sec("Tempo por fase", "⏱️")
        _tt = pd.DataFrame(
            [{"fase": k, "segundos": round(v, 2)} for k, v in timings.items()]
        ).sort_values("segundos", ascending=False).reset_index(drop=True)
        total = sum(timings.values())
        display(
            _tt.style.format({"segundos": "{:.2f}s"}).set_table_styles([
                {"selector": "th",
                 "props": f"background:{_NAVY};color:white;padding:6px 8px"},
                {"selector": "td", "props": "padding:5px 8px"},
            ])
        )
        display(Markdown(f"**Total: {total:.2f}s**"))

    return {
        "diagnostic_score":   diag_score,
        "quality_score":      qual_score,
        "diagnostic_report":  diag,
        "quality_report":     qual,
        "pk_report":          pk_report,
        "fk_report":          fk_report,
        "resumo_tabelas":     vol,
        "diagnostic_error":   diag_error,
        "quality_error":      qual_error,
        "preflight_problems": preflight_problems,
        "timings":            timings,
    }
