def _align_tables(
    real:  Dict[str, pd.DataFrame],
    synth: Dict[str, pd.DataFrame],
) -> Tuple[Dict[str, pd.DataFrame], Dict[str, pd.DataFrame]]:
    """
    Garante mesmas colunas e dtypes entre real e sintético.

    Estratégia de coerção por coluna:
        1. Se os dtypes já são iguais, não faz nada.
        2. Tenta converter o sintético para o dtype do real.
        3. Se falhar, converte ambos para string.

    Isso evita o ValueError do SDMetrics ao fazer joins internos de
    relacionamento quando a mesma coluna de chave tem dtype diferente
    entre tabela filha e tabela pai (ex.: string vs int64).
    """
    common = sorted(set(real) & set(synth))
    real_out, synth_out = {}, {}

    for t in common:
        r, s = real[t].copy(), synth[t].copy()
        cols = [c for c in r.columns if c in set(s.columns)]
        r, s = r[cols], s[cols]

        for c in cols:
            if str(r[c].dtype) == str(s[c].dtype):
                continue
            # Tentar numérico primeiro (preserva precisão de IDs)
            try:
                r_num = pd.to_numeric(r[c], errors="raise")
                s_num = pd.to_numeric(s[c], errors="raise")
                # Normalizar para o mesmo tipo numérico
                target = (
                    "float64"
                    if "float" in str(r_num.dtype) or "float" in str(s_num.dtype)
                    else "int64"
                )
                r[c] = r_num.astype(target)
                s[c] = s_num.astype(target)
            except (ValueError, TypeError):
                # Fallback: ambos como string
                r[c] = r[c].astype(str).replace("nan", pd.NA).astype("string")
                s[c] = s[c].astype(str).replace("nan", pd.NA).astype("string")

        real_out[t], synth_out[t] = r, s

    return real_out, synth_out


# ============================================================
# 3. Metadata para SDMetrics
# ============================================================

def _normalize_cols_cfg(v: Any) -> List[str]:
    if v is None:
        return []
    if isinstance(v, str):
        return [v]
    return [str(c) for c in v]


def _sdtype_of(series: pd.Series, is_key: bool) -> Dict[str, str]:
    if is_key:
        return {"sdtype": "id"}
    if pd.api.types.is_bool_dtype(series):
        return {"sdtype": "boolean"}
    if pd.api.types.is_datetime64_any_dtype(series):
        return {"sdtype": "datetime"}
    if pd.api.types.is_numeric_dtype(series):
        return {"sdtype": "numerical"}
    return {"sdtype": "categorical"}


def build_sdmetrics_metadata(
    real: Dict[str, pd.DataFrame],
    specs_config: Mapping[str, Mapping],
) -> Dict[str, Any]:
    """
    Converte specs_config no formato de metadata multi-tabela do SDMetrics.
    FKs compostas são ignoradas aqui (cobertas pela checagem direta).

    IMPORTANTE (correção): um relacionamento só é incluído quando a coluna-pai
    (`parent_columns`) está realmente declarada como `primary_key` ÚNICA da
    tabela-pai. O SDMetrics valida a metadata e REJEITA — derrubando os DOIS
    reports — qualquer relationship cujo `parent_primary_key` não bata com a
    primary_key declarada da tabela (caso típico: FK simples apontando para
    uma tabela de PK composta). Esses vínculos inconsistentes continuam
    auditados na checagem direta de FK; só não entram na metadata do SDMetrics.
    """
    meta: Dict[str, Any] = {"tables": {}, "relationships": []}
    key_cols: Dict[str, set] = {}

    for t, cfg in specs_config.items():
        pks = set(_normalize_cols_cfg(cfg.get("pk_cols")))
        fks: set = set()
        for fk in (cfg.get("foreign_keys") or cfg.get("fks") or []):
            fks.update(_normalize_cols_cfg(fk.get("columns")))
        key_cols[t] = pks | fks

    # primary_key declarada (única) por tabela, para validar os relacionamentos
    declared_pk: Dict[str, Optional[str]] = {}

    for t, df in real.items():
        cfg  = specs_config.get(t, {})
        pks  = _normalize_cols_cfg(cfg.get("pk_cols"))
        cols = {
            c: _sdtype_of(df[c], c in key_cols.get(t, set()))
            for c in df.columns
        }
        tmeta: Dict[str, Any] = {"columns": cols}
        if len(pks) == 1 and pks[0] in df.columns:
            tmeta["primary_key"] = pks[0]
            declared_pk[t] = pks[0]
        else:
            declared_pk[t] = None
        meta["tables"][t] = tmeta

    for t, cfg in specs_config.items():
        if t not in real:
            continue
        for fk in (cfg.get("foreign_keys") or cfg.get("fks") or []):
            cols  = _normalize_cols_cfg(fk.get("columns"))
            pcols = _normalize_cols_cfg(fk.get("parent_columns"))
            ptab  = fk.get("parent_table")
            if not ptab or ptab not in real:
                continue
            if len(cols) != 1 or len(pcols) != 1:
                continue  # FK composta: tratada só na checagem direta
            # A coluna-pai PRECISA ser a primary_key única declarada do pai,
            # senão o SDMetrics rejeita a metadata inteira.
            if declared_pk.get(ptab) != pcols[0]:
                continue
            # As colunas precisam existir de fato nas duas tabelas.
            if cols[0] not in meta["tables"].get(t, {}).get("columns", {}):
                continue
            if pcols[0] not in meta["tables"].get(ptab, {}).get("columns", {}):
                continue
            meta["relationships"].append({
                "parent_table_name":  ptab,
                "parent_primary_key": pcols[0],
                "child_table_name":   t,
                "child_foreign_key":  cols[0],
            })

    return meta


# ============================================================
# 3b. Validação / robustez da geração SDMetrics
# ============================================================

def _strip_relationships(meta: Mapping[str, Any]) -> Dict[str, Any]:
    """Cópia da metadata SEM relacionamentos (fallback quando o cálculo de
    relacionamento quebra a geração)."""
    return {"tables": dict(meta.get("tables", {})), "relationships": []}


def _preflight_metadata(
    real:  Dict[str, pd.DataFrame],
    synth: Dict[str, pd.DataFrame],
    specs_config: Mapping[str, Mapping],
    metadata: Mapping[str, Any],
) -> List[str]:
    """
    Verificações baratas ANTES de chamar o SDMetrics. Retorna uma lista de
    problemas em linguagem clara — vazia se estiver tudo certo. Cobre as
    causas mais comuns de n/d:
      • nenhuma tabela carregada / nenhuma em comum (divergência de casing);
      • tabela vazia ou sem colunas em comum;
      • metadata sem tabelas;
      • relacionamento referenciando coluna que não é a primary_key do pai.
    """
    problemas: List[str] = []

    if not real:
        problemas.append("Nenhuma tabela ORIGINAL foi carregada.")
    if not synth:
        problemas.append("Nenhuma tabela SINTÉTICA foi carregada.")

    comuns = sorted(set(real) & set(synth))
    if real and synth and not comuns:
        problemas.append(
            "Nenhuma tabela em comum entre original e sintético — provável "
            f"divergência de NOME/CASING. Original={sorted(real)} vs "
            f"Sintético={sorted(synth)}."
        )

    for t in comuns:
        if len(real.get(t, [])) == 0:
            problemas.append(f"Tabela '{t}' (original) está vazia.")
        if len(synth.get(t, [])) == 0:
            problemas.append(f"Tabela '{t}' (sintético) está vazia.")
        if t in real and len(real[t].columns) == 0:
            problemas.append(f"Tabela '{t}' não tem colunas em comum entre original e sintético.")

    if not metadata.get("tables"):
        problemas.append(
            "Metadata do SDMetrics ficou sem tabelas — generate() iria falhar. "
            "Verifique se os nomes em specs_config batem com os dados carregados."
        )

    tabs = metadata.get("tables", {})
    for rel in metadata.get("relationships", []):
        pt, ppk = rel["parent_table_name"], rel["parent_primary_key"]
        ct, cfk = rel["child_table_name"],  rel["child_foreign_key"]
        tdef = tabs.get(pt, {})
        if tdef.get("primary_key") != ppk:
            problemas.append(
                f"Relacionamento {ct}.{cfk} → {pt}.{ppk}: '{ppk}' não está "
                f"declarada como primary_key de '{pt}' (PK atual: "
                f"{tdef.get('primary_key')!r})."
            )
        if cfk not in tabs.get(ct, {}).get("columns", {}):
            problemas.append(f"FK '{cfk}' não existe nas colunas de '{ct}'.")
        if ppk not in tdef.get("columns", {}):
            problemas.append(f"PK '{ppk}' não existe nas colunas de '{pt}'.")

    return problemas


def _try_report(
    report_cls,
    real:  Dict[str, pd.DataFrame],
    synth: Dict[str, pd.DataFrame],
    metadata: Mapping[str, Any],
    verbose: bool,
) -> Tuple[Any, Optional[float], Optional[pd.DataFrame], Optional[str], bool]:
    """
    Gera um report do SDMetrics com tolerância a falha:
      1ª tentativa: metadata completa (com relacionamentos);
      2ª tentativa: metadata SEM relacionamentos (fallback).

    Retorna (report, score, properties, traceback_str, usou_fallback).
    Se ambas as tentativas falharem, retorna (None, None, None, tb, False)
    com o traceback COMPLETO empilhado para exibição/diagnóstico.
    """
    erros: List[str] = []
    variantes = [(metadata, False), (_strip_relationships(metadata), True)]

    for meta, is_fallback in variantes:
        # Pula a 2ª tentativa se não havia relacionamento (seria idêntica).
        if is_fallback and not metadata.get("relationships"):
            break
        try:
            rep = report_cls()
            rep.generate(real, synth, meta, verbose=verbose)
            score = float(rep.get_score())
            props = rep.get_properties()
            return rep, score, props, ("\n\n".join(erros) or None), is_fallback
        except Exception:
            etiqueta = "SEM relacionamentos" if is_fallback else "metadata completa"
            erros.append(f"[tentativa: {etiqueta}]\n{traceback.format_exc()}")

    return None, None, None, "\n\n".join(erros), False


def _last_exc_line(tb: Optional[str]) -> str:
    """Última linha não-vazia de um traceback (a mensagem da exceção)."""
    if not tb:
        return ""
    linhas = [l for l in tb.strip().splitlines() if l.strip()]
    return linhas[-1] if linhas else ""


def _fence(text: Optional[str]) -> str:
    """Embrulha texto num bloco de código Markdown."""
    return "```\n" + (text or "").strip() + "\n```"


def _fast_column_shapes(
    real:  Dict[str, pd.DataFrame],
    synth: Dict[str, pd.DataFrame],
    metadata: Mapping[str, Any],
) -> Tuple[Optional[float], pd.DataFrame]:
    """
    Column Shapes SEM o Column Pair Trends — evita o custo O(colunas²) que é
    o gargalo do QualityReport em tabelas largas.

    Para cada coluna não-chave:
      • numérica            → KSComplement = 1 - estatística KS (scipy.ks_2samp)
      • categórica/booleana → TVComplement = 1 - TVD
        (TVD = 0.5 · Σ |p_real(cat) - p_synth(cat)| sobre a união de categorias)

    Custo por coluna: O(n log n) (numérica) ou O(n) (categórica). Sem pares.
    Retorna (score_médio, detalhe_por_coluna).
    """
    try:
        from scipy.stats import ks_2samp
    except Exception:
        ks_2samp = None

    linhas: List[dict] = []
    tabs = metadata.get("tables", {})

    for t in sorted(set(real) & set(synth)):
        cols_meta = tabs.get(t, {}).get("columns", {})
        r_df, s_df = real[t], synth[t]
        for col in r_df.columns:
            if col not in s_df.columns:
                continue
            if cols_meta.get(col, {}).get("sdtype", "") == "id":
                continue  # chaves não entram em Column Shapes
            r = r_df[col].dropna()
            s = s_df[col].dropna()
            if len(r) == 0 or len(s) == 0:
                continue

            if pd.api.types.is_numeric_dtype(r) and pd.api.types.is_numeric_dtype(s):
                metric = "KSComplement"
                if ks_2samp is not None:
                    try:
                        stat  = ks_2samp(r.values, s.values).statistic
                        score = 1.0 - float(stat)
                    except Exception:
                        score = np.nan
                else:
                    score = np.nan
            else:
                metric = "TVComplement"
                r_p  = r.astype(str).value_counts(normalize=True)
                s_p  = s.astype(str).value_counts(normalize=True)
                cats = r_p.index.union(s_p.index)
                tvd  = 0.5 * float(
                    (r_p.reindex(cats, fill_value=0.0)
                     - s_p.reindex(cats, fill_value=0.0)).abs().sum()
                )
                score = 1.0 - tvd

            linhas.append({
                "Table":  t,
                "Column": col,
                "Metric": metric,
                "Score":  score,
            })

    detail = pd.DataFrame(linhas)
    media  = float(detail["Score"].mean()) if len(detail) else None
    return media, detail


